  "facultyRules": [
    "51.5 נקודות בחירה פקולטית: להשלים 3 קבוצות התמחות שונות מתוך 11 — 9 מקצועות שונים, 3 בכל קבוצה, כולל המקצועות המחייבים בקבוצה.",
    "לפחות 26 נקודות משלוש קבוצות ההתמחות שנבחרו.",
    "15 נקודות נוספות מרשימה א׳ (כל מקצועות הפקולטה למדעי המחשב), ועוד 10.5 נקודות מרשימה א׳ או מרשימה ב׳.",
    "כל סטודנט חייב להשתתף בשני פרויקטים לפחות, או בפרויקט אחד וסמינר אחד."
  ],
  "freeRules": [
    "12 נקודות בחירה כלל־טכניונית.",
    "מתוכן לפחות 6 נקודות מקצועות העשרה ולפחות 2 נקודות חינוך גופני.",
    "השאר — בחירה חופשית מכל המקצועות בטכניון, בכפוף לכללי הרישום."
  ],
